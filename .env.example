# ============================================================================
# StressLens AI — Environment Configuration Example
# Copy this file to .env to customize settings.
# ============================================================================

# Ollama local inference server URL
OLLAMA_HOST=http://localhost:11434

# Request timeout in seconds for Ollama API calls
OLLAMA_REQUEST_TIMEOUT=30

# Temperature for SLM generation (lower values yield more consistent JSON)
OLLAMA_TEMPERATURE=0.3

# Background polling interval in seconds for checking new perception readings
POLL_INTERVAL_SECONDS=1.0

# Number of seconds before perception data feed is considered inactive
STALE_DATA_SECONDS=45.0

# Maximum number of history points to retain in memory and persistence
HISTORY_MAX_POINTS=300

# Streamlit UI auto-refresh period in seconds
UI_REFRESH_SECONDS=2

# Application title displayed in the browser tab
APP_TITLE=StressLens AI — On-Device Stress Detector
